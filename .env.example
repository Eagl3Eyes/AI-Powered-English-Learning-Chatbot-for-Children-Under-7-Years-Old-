# Environment Configuration (Placeholder values only - No secrets committed)

# Server Port (default 4000)
PORT=4000
NODE_ENV=production

# Optional: Google Gemini API Key for enriched open-ended conversations
# If omitted or if API is unreachable/slow, the deterministic child learning fallback engine automatically runs with < 50ms latency.
GEMINI_API_KEY=

# Optional: OpenAI API Key (Alternative LLM provider)
OPENAI_API_KEY=
